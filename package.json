{
  "name": "pi-issue-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "pi-issue-bot 控制面 monorepo（骨架阶段：只有工具链与门禁，无业务代码）",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:all": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "gen:openapi": "pnpm --filter @pi-issue-bot/contract gen:openapi",
    "cli": "tsx apps/server/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}

# pi-issue-bot 的环境变量清单（systemd `EnvironmentFile=/etc/pi-bot/env`，权限 0600 root:pi）
#
# 用法：复制本文件到 /etc/pi-bot/env，按注释填值，**不要提交真实密钥**。
# 变量与代码的对应关系：`apps/server/src/app/config.ts`（APP_ENV_KEYS）与 `config/env.ts`。

# ── 必填：数据库（业务表 + pg-boss 同一个库、不同 schema）─────────────────────
PI_BOT_PG_DSN=postgres://pi_bot:CHANGE_ME@127.0.0.1:5432/pi_bot
# 兼容旧名（二选一；两个都给时 PI_BOT_PG_DSN 优先）
# PI_BOT_DATABASE_URL=postgres://pi_bot:CHANGE_ME@127.0.0.1:5432/pi_bot

# ── 必填：GitHub App webhook secret（验签；不设就无法接收投递）─────────────────
PI_BOT_WEBHOOK_SECRET=CHANGE_ME

# ── 必填：数据目录（job worktree、clone 缓存、磁盘水位都在这下面）──────────────
PI_BOT_DATA_DIR=/var/lib/pi-bot

# ── 可选：HTTP 与指标（默认只监听 loopback，由 Caddy 反代 3000）──────────────
PI_BOT_HTTP_HOST=127.0.0.1
PI_BOT_PORT=3000
PI_BOT_METRICS_HOST=127.0.0.1
PI_BOT_METRICS_PORT=9464
PI_BOT_LOG_LEVEL=info

# ── 模型端点：标准 OpenAI / DeepSeek / MiMo 兼容接口 ────────────────────────
# 只配这三项就够；兼容别名 OPENAI_API_KEY / OPENAI_BASE_URL / DEEPSEEK_API_KEY /
# DEEPSEEK_BASE_URL 也会被读取（我们自己的名字优先）。
#
# DeepSeek:
#   PI_BOT_MODEL_BASE_URL=https://api.deepseek.com/v1
#   PI_BOT_MODEL_NAME=deepseek-chat
# OpenAI:
#   PI_BOT_MODEL_BASE_URL=https://api.openai.com/v1
#   PI_BOT_MODEL_NAME=gpt-4o-mini
# MiMo（照厂商文档的 OpenAI 兼容地址填）:
#   PI_BOT_MODEL_BASE_URL=https://<mimo-endpoint>/v1
#   PI_BOT_MODEL_NAME=<模型名>
PI_BOT_MODEL_BASE_URL=https://api.deepseek.com/v1
PI_BOT_MODEL_NAME=deepseek-chat
PI_BOT_MODEL_API_KEY=CHANGE_ME
# 注：key 会以 OPENAI_API_KEY 的名字一并交给 pi-host（可信侧），永不进任务容器。

# ── 可选：pi-host bundle 与设备令牌（`pi-bot bootstrap-host` 产出）───────────
# 没有 bundle 也能启动：任务会在 host 步骤以 HOST_UNAVAILABLE 失败（dry-run 不受影响）。
PI_BOT_HOST_BUNDLE_DIR=/usr/local/lib/pi-bot/pi-host/<version>
PI_BOT_HOST_DATA_DIR=/var/lib/pi-bot/host
PI_BOT_HOST_TOKEN=pdt1.REPLACE_ME

# ── 可选：沙箱 ─────────────────────────────────────────────────────────────
PI_BOT_WORKER_IMAGE=pi-worker:node22
PI_BOT_SANDBOX_NETWORK=pi-jobs
PI_BOT_JOB_ROOT=/var/lib/pi-bot/jobs
PI_BOT_CACHE_ROOT=/var/lib/pi-bot/cache

# ── 安全开关（默认最保守）──────────────────────────────────────────────────
# dry-run：worker 一次 GitHub 写都不做（M0 的 ⛔ 项）。plan §11：M1 首周强制开。
PI_BOT_DRY_RUN=true
# 允许 push_branch：写回闸门未通过前不要开（tech-plan §5.6，M4 阻断项）
PI_BOT_ALLOW_PUSH_BRANCH=false
# webhook 的 10 秒应答（eyes reaction）用的 token；worker 的写面走 GitHub App 认证
PI_BOT_GITHUB_TOKEN=

# GitHub App 认证（推荐：权限比静态 token 更窄，installation token 1 小时过期）
# 三件齐全才生效；只配一半会以 degraded 告警，不会静默退回未认证。
# 安装 ID 在「Install App」装到账号/仓库后，从安装设置页 URL 末尾拿到。
PI_BOT_GITHUB_APP_ID=5690173
PI_BOT_GITHUB_APP_PRIVATE_KEY_PATH=/etc/pi-bot/app.pem
PI_BOT_GITHUB_INSTALLATION_ID=
